# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is gitignored.

project_id  = "gmo-interpretation-dev"
region      = "asia-northeast1"
zone        = "asia-northeast1-a"
environment = "dev"
name_prefix = "interp"

