# Copy to .env and fill in values
# Source: `export $(cat .env | xargs)`

GCP_PROJECT_ID=gmo-interpretation-dev
GCP_REGION=asia-northeast1

# Vertex AI (Gemini)
VERTEX_AI_REGION=asia-northeast1
GEMINI_MODEL=gemini-2.5-flash

# Speech-to-Text V2
STT_REGION=asia-northeast1
STT_RECOGNIZER_ID=interp-jp-default
STT_MODEL=chirp_3
STT_LANGUAGE=ja-JP

# Text-to-Speech
TTS_REGION=global
