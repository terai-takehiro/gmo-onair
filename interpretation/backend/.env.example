# Copy to .env for local development.
# In production, values are loaded from Google Secret Manager via config.py.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# GCP
GCP_PROJECT_ID=gmo-interpretation-dev
GCP_REGION=asia-northeast1

# Vertex AI / Gemini
VERTEX_AI_REGION=asia-northeast1
GEMINI_MODEL=gemini-2.5-flash

# Speech-to-Text V2
STT_REGION=asia-northeast1
STT_LANGUAGE=ja-JP
STT_MODEL=chirp_3

# Text-to-Speech
TTS_REGION=global

# Postgres (Cloud SQL via private IP in prod, localhost in dev)
DATABASE_URL=postgresql+asyncpg://interpretation_app:devpass@localhost:5432/interpretation

# Redis (Memorystore in prod)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=dev-only-change-me
JWT_ALG=HS256
JWT_TTL_HOURS=12

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
