[Unit]
Description=GMO ONAiR Deploy Webhook
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/gmo-onair
ExecStart=/usr/bin/node /opt/gmo-onair/scripts/deploy-webhook.js
Restart=always
RestartSec=5
Environment=DEPLOY_DIR=/opt/gmo-onair
Environment=WEBHOOK_SECRET=your-secret-here

[Install]
WantedBy=multi-user.target
