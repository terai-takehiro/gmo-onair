node_modules/
dist/
*.db
*.sqlite
.DS_Store
*.log
.vite/

# Dev Basic Auth (VPS上でのみ作成)
deploy/dev-htpasswd

# Environment & secrets - NEVER commit these
.env
.mcp.json
.env.local
.env.production
.env.*.local
*.pem
*.key
credentials.json
service-account.json

# TypeScript build info
*.tsbuildinfo

# k6 負荷試験の生成物
scripts/loadtest/results/

# バージョン履歴 JSON（scripts/generate-version-history.mjs が CLAUDE.md から都度生成。
# client の prebuild/predev で自動生成されるためコミット不要）
client/public/version-history.json
# MCP ツールカタログ JSON（scripts/generate-mcp-tools.mjs が tools/*.tools.ts から都度生成）
client/public/mcp-tools.json

# Claude Code worktrees (sub-agent isolated workspaces)
.claude/worktrees/

# 検証用の使い捨てスクリプト置き場 (v2.9.296)
# 実 Postgres での確認スクリプトは `pg` を解決するためワークスペース内に置く必要があるが、
# リポジトリに入れてはいけない (v2.9.294 で消し忘れた 1 本が CI の lint を落とした)。
# ここに置けば消し忘れても混入しない。
**/verify-scratch/

# 検証用ブラウザに渡す書体の取り置き (scripts/lib/google-fonts-cache.mjs)
# Google Fonts から落とした CSS と woff2 (約20MB)。手元で作り直せるのでコミットしない。
.cache/

# rental-scraper (Python) の実行時生成物。クロール結果のSQLiteとキャッシュはコミットしない
rental-scraper/__pycache__/
rental-scraper/rental_items.db
rental-scraper/crawl.log

# サーバーの UPLOAD_DIR (実行時生成物)。リポジトリ直下でサーバーを起動すると
# シードがダミー画像 (awards のアバター等) をここへ書き出す。データはコミットしない
uploads/
