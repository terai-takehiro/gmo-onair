# =============================================================================
# GMO ONAiR — 環境変数テンプレート
# =============================================================================
# cp .env.example .env && vim .env
# ⚠ .env は絶対にGitにコミットしないでください (.gitignore済み)
# =============================================================================

# --- PostgreSQL ---
DB_PASSWORD=your_secure_password_here
# ↑ openssl rand -hex 16 で生成推奨

# --- JWT ---
JWT_SECRET=your_jwt_secret_here
# ↑ openssl rand -hex 32 で生成推奨 (本番)
JWT_SECRET_DEV=your_dev_jwt_secret_here
# ↑ openssl rand -hex 32 で生成推奨 (検証環境用)。本番とは必ず別の値にすること。

# --- Encryption Key (v2.8.19+) --- liveops の YouTube/JStream トークン暗号化用 (AES-256-GCM)
# 本番では必須 (未設定だと liveops 暗号化処理がエラー)。dev は JWT_SECRET から派生キーを生成。
# ENCRYPTION_KEY=your_64_char_hex_encryption_key_here
# ↑ openssl rand -hex 32 で生成推奨

# --- マスター管理者 (v2.8.19+) --- 本番起動時に自動作成される system_admin のメールアドレス
# 未設定なら seed-admin は起動時 no-op (管理者は別途 SQL/CLI で作成する想定)
# ADMIN_EMAIL=admin@example.com

# --- SMS (Twilio) --- 本番のみ。未設定時はコンソールログ出力
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+81xxxxxxxxxx

# --- Email (SMTP) --- 本番のみ。未設定時はコンソールログ出力
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@gmo-onair.jp

# --- CoNoHa VPS スケーリング (v2.7.1+) --- 未設定時はインタラクティブの「サイズ変更」ボタンが 503 NOT_CONFIGURED を返す
# CoNoHa コントロールパネル → 「API」→ 「APIユーザー」で API ユーザーを発行
# CONOHA_API_USERNAME=gncu12345678
# CONOHA_API_PASSWORD=（API ユーザー作成時に設定したパスワード）
# 「API」→ 「APIテナント情報」タブの「テナントID」
# CONOHA_TENANT_ID=（32桁の英数字）
# 「サーバー」→ 該当 VPS の詳細画面に表示されるサーバーUUID
# CONOHA_SERVER_ID=（32桁の英数字）
# リージョンが東京以外の場合のみ上書き (例: 大阪 = c3j1.conoha.io)
# CONOHA_IDENTITY_ENDPOINT=https://identity.tyo2.conoha.io/v2.0
# CONOHA_COMPUTE_ENDPOINT=https://compute.tyo2.conoha.io/v2/{TENANT_ID}

# --- BOX 連携 (v2.7.0+ / v2.7.10) --- 未設定時は BOX 連携が無効化される
# 設定すると、案件作成時に BOX に自動でフォルダツリーが生成される。
# (案件名 _OPP-xxxx → GLS 発番後は _GLS-xxxxx に自動リネーム / 名前変更も追従)
#
# 1) BOX 開発者コンソールで JWT App を作成 → JSON 設定をダウンロード
# 2) ダウンロードした JSON を 1 行に圧縮して以下に貼り付け (シングルクォート必須)
#    例: BOX_CONFIG_JSON='{"boxAppSettings":{"clientID":"...","clientSecret":"...","appAuth":{"publicKeyID":"...","privateKey":"-----BEGIN ENCRYPTED PRIVATE KEY-----\n...\n-----END ENCRYPTED PRIVATE KEY-----\n","passphrase":"..."}},"enterpriseID":"..."}'
# BOX_CONFIG_JSON=
#
# 3) BOX 上に「外部 (社外) 案件用」「内部 (社内) 案件用」の 2 つの親フォルダを作成し、
#    それぞれの URL 末尾の数字 (フォルダ ID) を以下に設定:
# BOX_PROJECT_PARENT_FOLDER_ID=        # 外部案件 (customer_type=external)
# BOX_PROJECT_PARENT_FOLDER_ID_INTERNAL= # 内部案件 (customer_type=internal)
#
# どちらか一方だけ設定するとそちら側だけ自動作成が動く (もう片方は no-op)。

# --- MCP サーバー (v2.9.171+) --- Claude Code 等の MCP クライアント連携用 APIキー
# 未設定なら /api/v1/mcp は 503 (機能無効) を返すだけで安全に眠っている。
# 本番と検証で必ず別のキーを使うこと。openssl rand -hex 32 で生成推奨。
# 登録例: claude mcp add --transport http onair https://dev.gmo-onair.jp/api/v1/mcp \
#           --header "Authorization: Bearer <MCP_API_KEY_DEV>"
# MCP_API_KEY=        # 本番 (gmo-onair.jp)
# MCP_API_KEY_DEV=    # 検証 (dev.gmo-onair.jp)

# --- 投入欄「AIに投げる」の解析 (v2.9.246+ / v3.0.6 で行動提案に拡張) ---
# トップページの投入欄に貼った文 (議事録・メール・ひとことメモ) を LLM で読み、
# ONAiR のどの操作にするかを提案する — 案件をつくる / お客様を登録する /
# ヨミを動かす / GLS発番 / 見積の下書き / スタジオ仮押さえ / 営業活動の記録 /
# 問い合わせ / 議事録 / 案件メモ / タスク・依頼 の 11 種。
# **提案するだけで、人が確認して押すまで 1 件も登録されない。**
#
# 未設定のときの挙動:
#   - 行動提案は使えない (「どの操作にするか」は規則では決められないため。
#     画面は従来のタスク投入欄に自動で戻る)
#   - タスク・依頼の投入は動く (規則ベースの解析に縮退する)
#
# OpenAI (ChatGPT) を使う場合 — https://platform.openai.com/api-keys で発行
# OPENAI_API_KEY=           # 本番 (gmo-onair.jp)
# OPENAI_API_KEY_DEV=       # 検証 (dev.gmo-onair.jp)。未設定なら本番キーを共用する
#
# Anthropic (Claude) を使う場合 — https://console.anthropic.com/settings/keys で発行
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_DEV=
#
# どちらのキーも入っているときは OpenAI が優先される。明示したいときだけ指定する。
# INTAKE_AI_PROVIDER=openai    # openai | anthropic
# INTAKE_AI_PROVIDER_DEV=
#
# ── どの仕事にどのモデルを使うか (段は2つだけ) ────────────────────────
# 決め方の実体は server/src/shared/services/ai-model.ts。**そこが唯一の正**。
#
#   light … 形を整える・短い文から項目を拾う (間違えても人がその場で気づける)
#   heavy … 取引先との合意を記録する・写真や PDF を読む・長い文をまとめる
#
# **判断の基準は「間違いに気づけるか」で、費用ではない。** 気づけない間違い
# (議事録の決定事項が捏造される等) は、何円安くなっても割に合わない。
#
#   仕事                    既定    heavy に上がる条件
#   ----------------------  ------  --------------------------------
#   投入口の解析            light   添付あり / 400字超 / 7行超
#   やり取りの整形          light   4,000字超
#   議事録の構造化          heavy   常に (合意の記録・引用が必須)
#   KPT の下書き            heavy   常に (長い材料をまとめる)
#   文字起こし (Whisper)    —       モデルは1つだけ (MINUTES_STT_MODEL)
#
# ⚠️ **軽いモデルで落ちたら上位モデルで1回だけやり直す** (投入口・やり取りとも)。
#    モデル名が使えない環境で黙って失敗すると、「整わない記録がある」「行き先を
#    決めてくれなくなった」という**理由の分からない劣化**になるため。
#    ただしやり直すのは**落ちたときだけ**。中身が気に入らないときはやり直さない
#    (もっともらしいが違う、は例外にならない。人が「整え直す」を押すのが正しい直し方)。
#
# 段ごとのモデル名。**機能をまたいで効く**。未設定なら
#   heavy = gpt-5.6-terra / claude-opus-5、light = gpt-5.6-luna / claude-haiku-4-5-20251001
# AI_MODEL_HEAVY=
# AI_MODEL_LIGHT=                 # off と書くと軽いモデルを一切使わない
# AI_MODEL_HEAVY_DEV=             # 検証だけ変えたいとき
# AI_MODEL_LIGHT_DEV=
#
# 機能ごとの名指し。**段より先に効く** (入れると長い入力でも上がらない)。
# ⚠️ **迷ったら入れないこと。** 入れるほど「なぜこのモデルなのか」を追う場所が増える。
# INTAKE_AI_MODEL=                # 投入口の解析（`INTAKE_AI_MODEL_DEV` で検証だけ変えられる）
# INTAKE_AI_MODEL_LIGHT=          # 投入口の軽いほうだけ。off で軽いモデルを使わない
# ACTIVITY_AI_MODEL=              # やり取りの整形。**精度が落ちたらここで heavy に戻せる**
# MINUTES_AI_MODEL=               # 議事録の構造化
# KPT_AI_MODEL=                   # KPT の下書き
# MINUTES_STT_MODEL=              # 文字起こし (既定 whisper-1)
#
# ⚠️ **`MINUTES_AI_MODEL` はもう議事録にしか効かない。** v4.0.4 より前は
#    やり取りと KPT の落とし先にもなっていて、1つ入れると3機能が巻き添えで変わった。

# ── AI の使用量と概算費用 (設定 → システムの情報 → 「AI の使用量」) ─────
# 呼び出しは種類ごとに ai_usage へ1行ずつ残る (migration 181)。**これは常に動く。**
#
# 金額を出したいときだけ単価を入れる。**公開価格をコードに焼き込んでいない** —
# 変わるうえ、焼き込むと「いつの値段か」が分からないまま金額が独り歩きする。
# 入れなくてもトークン数と録音の分数は出るので、どこが重いかは分かる。
#
#   in / cached_in / out … 100万トークンあたりの USD
#   per_min             … 1分あたりの USD (文字起こし)
#
# **単価を入れていないモデルは合計に足さない** (0 として混ぜると総額が嘘になる)。
# 値は https://openai.com/api/pricing/ で確認して入れること (下は書き方の例)。
# AI_PRICING_JSON={"gpt-5.6-terra":{"in":2,"cached_in":0.2,"out":12},"gpt-5.6-luna":{"in":0.2,"cached_in":0.02,"out":1.2},"whisper-1":{"per_min":0.006}}
#
# ⚠️ **鍵は「実際に呼んだモデル名」と1文字も違わないこと。** 合わないと
#    **その行は合計に足されず、静かに安く見えます**。実際に何を呼んだかは
#    本番の DB で確かめられます:
#      SELECT DISTINCT model, count(*) FROM ai_usage GROUP BY model ORDER BY 2 DESC;
#
# ⚠️ **1行で書くこと**（途中で改行すると JSON として読めず、金額が出なくなる）。
#    読めなかったときはサーバーの起動ログに `AI_PRICING_JSON を読めませんでした` が出る。


# ── 打合せの録音 → 議事録 (案件詳細のやり取りタブ / トップの投入口) ──────
# 文字起こしは **Whisper** (2026-08 の決定)。OPENAI_API_KEY を使う。
# **キーが無い環境では録音ボタンが押せなくなる** (押してから「使えません」を出さない)。
#
# ⚠️ **「録音が動かない」の原因が鍵とは限らない。** 2026-08 に実際に起きたのは
#    **鍵ではなく画面側**の不具合で、axios が FormData を JSON に変換していたため
#    **音声がサーバーに届いていませんでした**（`shared/src/client/createApi.ts` に理由）。
#    まず 設定 → システムの情報 →「外部サービスにつながっているか」で鍵を確かめ、
#    つながっているのに動かないなら `project_minutes.error_message` を見てください。
#
# ⚠️ **録音は OPENAI_API_KEY でしか動かない。** ANTHROPIC_API_KEY だけを入れた環境では
#    「投入口の行き先判断」は動くのに**録音だけが動かない**という形になる
#    (Whisper は OpenAI のサービスなので、Anthropic の鍵では代われない)。
#
# ⚠️ **検証 (dev.gmo-onair.jp) にも届いているか確認すること。**
#    docker-compose は検証側に OPENAI_API_KEY_DEV → OPENAI_API_KEY の順で渡すので、
#    OPENAI_API_KEY を入れてあれば検証にも届く。**ただし .env を書き換えたあとは
#    `docker compose up -d app_dev` で入れ直さないと、動いているコンテナには反映されない**
#    (環境変数はコンテナ起動時に固定される)。
#
#    いま届いているかは **設定 → システムの情報 →「外部サービスにつながっているか」**
#    で確認できる (GET /admin/integrations)。開いている環境の答えが出るので、
#    検証を開けば検証の状態が分かる。鍵そのものは表示しない。
# MINUTES_STT_MODEL=whisper-1
#
# 文字起こしを議事録に整形するモデル。未設定なら INTAKE_AI_MODEL と同じ既定。
# 議事録は取引先との合意の記録なので、**精度側に振ったまま**にすることを勧める。
# MINUTES_AI_MODEL=
