# =============================================================================
# GMO ONAiR — 環境変数テンプレート
# =============================================================================
# cp .env.example .env && vim .env
# ⚠ .env は絶対にGitにコミットしないでください (.gitignore済み)
# =============================================================================

# --- PostgreSQL ---
DB_PASSWORD=your_secure_password_here
# ↑ openssl rand -hex 16 で生成推奨

# --- JWT ---
JWT_SECRET=your_jwt_secret_here
# ↑ openssl rand -hex 32 で生成推奨
JWT_SECRET_DEV=dev-jwt-secret-do-not-use-in-production

# --- SMS (Twilio) --- 本番のみ。未設定時はコンソールログ出力
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+81xxxxxxxxxx

# --- Email (SMTP) --- 本番のみ。未設定時はコンソールログ出力
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@gmo-onair.jp

# --- CoNoHa VPS スケーリング (v2.7.1+) --- 未設定時はインタラクティブの「サイズ変更」ボタンが 503 NOT_CONFIGURED を返す
# CoNoHa コントロールパネル → 「API」→ 「APIユーザー」で API ユーザーを発行
# CONOHA_API_USERNAME=gncu12345678
# CONOHA_API_PASSWORD=（API ユーザー作成時に設定したパスワード）
# 「API」→ 「APIテナント情報」タブの「テナントID」
# CONOHA_TENANT_ID=（32桁の英数字）
# 「サーバー」→ 該当 VPS の詳細画面に表示されるサーバーUUID
# CONOHA_SERVER_ID=（32桁の英数字）
# リージョンが東京以外の場合のみ上書き (例: 大阪 = c3j1.conoha.io)
# CONOHA_IDENTITY_ENDPOINT=https://identity.tyo2.conoha.io/v2.0
# CONOHA_COMPUTE_ENDPOINT=https://compute.tyo2.conoha.io/v2/{TENANT_ID}

# --- BOX 連携 (v2.7.0+) --- 未設定時は BOX 連携が無効化される
# BOX 開発者コンソールで JWT App を作成 → JSON 設定をダウンロード →
# 1 行に圧縮して BOX_CONFIG_JSON に貼り付け (シングルクォートで囲む)
# 例: BOX_CONFIG_JSON='{"boxAppSettings":{"clientID":"...","clientSecret":"...","appAuth":{"publicKeyID":"...","privateKey":"-----BEGIN ENCRYPTED PRIVATE KEY-----\n...\n-----END ENCRYPTED PRIVATE KEY-----\n","passphrase":"..."}},"enterpriseID":"..."}'
# BOX_CONFIG_JSON=
# 案件フォルダを作成する親フォルダの BOX フォルダ ID (BOX URL の末尾の数字)
# BOX_PROJECT_PARENT_FOLDER_ID=
