# =============================================================================
# GMO ONAiR - 環境変数テンプレート
# =============================================================================
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env
#
# ⚠️  .env ファイルは絶対にGitにコミットしないでください (.gitignore済み)
# =============================================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/onair_db
DB_PASSWORD=your_secure_password

# --- Server ---
PORT=3000
NODE_ENV=development
# production 時は以下のドメインを設定
# ALLOWED_ORIGINS=https://your-domain.com

# --- Client ---
# Vite開発サーバーのAPI接続先 (開発時は省略可)
# VITE_API_URL=http://localhost:3000/api/v1/internal

# --- Google OAuth 2.0 (本番認証) ---
# Google Cloud Console > APIs & Services > Credentials で作成
# この2つを設定すると自動的にOAuthモードに切り替わります
# 未設定の場合はmockAuth(開発モード)で動作します
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxx

# OAuth コールバックURL (本番ドメインに合わせて変更)
# OAUTH_CALLBACK_URL=https://your-domain.com/api/v1/internal/auth/google/callback

# クライアントURL (OAuth認証後のリダイレクト先)
# CLIENT_URL=https://your-domain.com

# --- JWT ---
# 本番環境では必ずランダムな64文字以上の文字列を設定してください
# 生成方法: openssl rand -hex 32
# JWT_SECRET=your-random-secret-here

# --- Qsheet Editor (外部コンテナ用) ---
# QSHEET_PATH=../GMO-Qsheet-Editor
# SESSION_SECRET=your-session-secret
# GOOGLE_CALLBACK_URL=https://your-domain.com/qsheet/auth/google/callback
# MASTER_EMAIL=admin@example.com

# --- EventStamp (外部コンテナ用) ---
# EVENTSTAMP_PATH=../gmo_eventstamp
# EVENTSTAMP_BASE_URL=https://your-domain.com/interactive
# GOOGLE_REDIRECT_URI=https://your-domain.com/interactive/api/auth/google/callback
